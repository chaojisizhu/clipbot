[Unit]
Description=ClipBot QQ media parser
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=clipbot
Group=clipbot
WorkingDirectory=/opt/clipbot
ExecStart=/opt/clipbot/start.sh bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
Environment=RUST_LOG=info
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/clipbot/cookies /opt/clipbot/temp_videos /opt/clipbot/temp_jm
CPUQuota=50%
MemoryMax=256M
TasksMax=64
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
